# Application environment
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:3000
LOCAL_FRONTEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/zorviq

# JWT settings
JWT_SECRET=replace_with_a_strong_random_secret

# Optional Redis cache
REDIS_URL=redis://localhost:6379

# Optional monitoring / error tracking
SENTRY_DSN=

# AWS Bedrock / Nova Pro settings
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_INFERENCE_PROFILE_ID=us.amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=replace_with_your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_your_aws_secret_access_key


# Rate limiter settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

#Resend for auth verification
RESEND_API_KEY=
RESEND_SKIP_EMAIL=false
RESEND_TEST_RECIPIENT=

#Redis for tocken blacklisting 
REDIS_PASSWORD=
REDIS_PORT=
REDIS_HOST=

#Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub integration (OAuth app — repo scope for deploy)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
