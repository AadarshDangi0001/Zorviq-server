# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ai-website-builder

# Upstash Redis
UPSTASH_REDIS_URL=rediss://<password>@<host>.upstash.io:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Anthropic Claude
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# CORS
CLIENT_URL=http://localhost:3000

# Generation limits
MAX_GENERATIONS_PER_MIN=10
