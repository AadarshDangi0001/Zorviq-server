# Application environment
NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:8080
LOCAL_FRONTEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/zorviq

# JWT settings
JWT_SECRET=replace_with_a_strong_random_secret

# Optional Redis cache
REDIS_URL=redis://localhost:6379

# Optional monitoring / error tracking
SENTRY_DSN=

# AWS Bedrock / Nova Pro settings
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_INFERENCE_PROFILE_ID=us.amazon.nova-pro-v1:0
AWS_ACCESS_KEY_ID=replace_with_your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_your_aws_secret_access_key


# Rate limiter settings
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# RAG embeddings and vector search
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1024
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_API_VERSION=2025-10
PINECONE_COMPONENT_NAMESPACE=components
PINECONE_COMPONENT_THRESHOLD=0.72
PINECONE_MEMORY_NAMESPACE=project-memory
PINECONE_MEMORY_THRESHOLD=0.68
PINECONE_NAMESPACE=code-pattern-errors
PINECONE_PATTERN_THRESHOLD=0.78

# SMTP mail for auth verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SKIP_EMAIL=false
SMTP_TEST_RECIPIENT=

#Redis for tocken blacklisting 
REDIS_PASSWORD=
REDIS_PORT=
REDIS_HOST=

#Google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub integration (OAuth app — repo scope for deploy)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
