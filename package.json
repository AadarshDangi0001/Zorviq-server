  },
  "homepage": "https://github.com/AadarshDangi0001/Zorviq-server#readme",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1054.0",
    "@octokit/rest": "^22.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "p-queue": "^9.3.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "resend": "^6.12.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
