{
  "name": "zorviq-server",
  "version": "1.0.0",
  "description": "Zorviq backend server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "nodemon --watch server.ts --watch src --ext ts,json --exec \"npm run build && node dist/server.js\""
  },
