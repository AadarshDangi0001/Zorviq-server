    {
      "name": "05 - AI Model Provider - Amazon Bedrock",
      "item": [
        {
          "name": "Invoke Bedrock Nova Model - Optional Direct Smoke Test",
          "request": {
            "auth": {
              "type": "awsv4",
              "awsv4": [
                { "key": "accessKey", "value": "{{aws_access_key_id}}", "type": "string" },
                { "key": "secretKey", "value": "{{aws_secret_access_key}}", "type": "string" },
                { "key": "sessionToken", "value": "{{aws_session_token}}", "type": "string" },
                { "key": "region", "value": "{{aws_region}}", "type": "string" },
                { "key": "service", "value": "bedrock", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "description": "Optional provider-level test for the AI model used by src/services/llm.service.ts. The backend normally invokes this through the AWS SDK, so this request is useful for validating AWS credentials, region, and model access independently from the API server.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"system\": [\n    {\n      \"text\": \"You are an expert frontend code generation assistant. Return concise, production-ready HTML only.\"\n    }\n  ],\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"text\": \"Generate a compact responsive pricing section for an AI website builder using semantic HTML and Tailwind classes.\"\n        }\n      ]\n    }\n  ],\n  \"inferenceConfig\": {\n    \"maxTokens\": 1024\n  }\n}"
            },
            "url": {
              "raw": "https://bedrock-runtime.{{aws_region}}.amazonaws.com/model/{{bedrock_model_id}}/invoke",
              "protocol": "https",
              "host": ["bedrock-runtime", "{{aws_region}}", "amazonaws", "com"],
              "path": ["model", "{{bedrock_model_id}}", "invoke"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bedrock model invocation succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Bedrock returns generated text payload', function () {",
                  "  const json = pm.response.json();",
                  "  const text = json.output?.message?.content?.[0]?.text || json.outputText || json.text;",
                  "  pm.expect(text).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
