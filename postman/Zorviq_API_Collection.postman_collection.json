{
  "info": {
    "name": "Zorviq API - AI Code Generation Test Suite",
    "description": "Professional Postman collection for Zorviq server. Covers auth, projects, AI code generation jobs, SSE/status/history, project export, negative validations, and optional direct Amazon Bedrock Runtime provider smoke testing. Run Login - Verified QA User before protected requests, or set auth_token manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const localBaseUrl = pm.environment.get('local_base_url') || 'http://localhost:4000';",
          "if (!pm.environment.get('base_url')) pm.environment.set('base_url', localBaseUrl);",
          "if (!pm.environment.get('run_id')) pm.environment.set('run_id', Date.now().toString());",
          "if (!pm.environment.get('qa_email')) pm.environment.set('qa_email', `zorviq.qa.${pm.environment.get('run_id')}@example.com`);",
          "if (!pm.environment.get('qa_password')) pm.environment.set('qa_password', 'StrongPass123');",
          "if (!pm.environment.get('qa_fullname')) pm.environment.set('qa_fullname', 'Zorviq QA User');",
          "if (!pm.environment.get('qa_contact')) pm.environment.set('qa_contact', '9876543210');",
          "if (!pm.environment.get('project_name')) pm.environment.set('project_name', `Postman AI Website ${pm.environment.get('run_id')}`);",
          "if (!pm.environment.get('section_id')) pm.environment.set('section_id', 'hero-section');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is acceptable', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('max_response_ms') || 5000));",
          "});",
          "",
          "pm.test('Sensitive fields are not leaked', function () {",
          "  const body = pm.response.text();",
          "  pm.expect(body).to.not.match(/\\\"password\\\"\\s*:/i);",
          "  pm.expect(body).to.not.match(/\\\"resetPasswordToken\\\"\\s*:/i);",
          "  pm.expect(body).to.not.match(/\\\"verificationToken\\\"\\s*:/i);",
          "  pm.expect(body).to.not.match(/\\\"passwordHash\\\"\\s*:/i);",
          "});",
          "",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "const isJson = contentType.includes('application/json');",
          "if (isJson && pm.response.text()) {",
          "  pm.test('JSON responses expose success boolean', function () {",
          "    const json = pm.response.json();",
          "    pm.expect(json).to.have.property('success');",
          "    pm.expect(json.success).to.be.a('boolean');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Health and Setup",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Confirms the Express server is running. This endpoint is public and does not require authentication.",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health endpoint returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health status is ok', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "  pm.expect(json).to.have.property('uptime');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register QA User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Creates a new QA user. The backend requires email verification before login, so use this request for onboarding and then verify through the email link. For regular protected API testing, use Login - Verified QA User.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{qa_email}}\",\n  \"fullname\": \"{{qa_fullname}}\",\n  \"password\": \"{{qa_password}}\",\n  \"contact\": \"{{qa_contact}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns created or duplicate validation', function () {",
                  "  pm.expect([201, 400]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.test('Registered user payload is present', function () {",
                  "    pm.expect(json.data.user).to.have.property('email');",
                  "    pm.expect(json.data.user.email).to.eql(pm.environment.get('qa_email').toLowerCase());",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Verified QA User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Authenticates a pre-verified QA account and stores auth_token and user_id. Because this backend blocks login for unverified users, set verified_user_email and verified_user_password to a verified account for full-suite runs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{verified_user_email}}\",\n  \"password\": \"{{verified_user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Token and user are returned', function () {",
                  "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.user).to.have.property('email');",
                  "});",
                  "pm.environment.set('auth_token', json.data.token);",
                  "pm.environment.set('user_id', json.data.user.id || json.data.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Returns the current authenticated user from the bearer token.",
            "url": {
              "raw": "{{base_url}}/api/auth/get-me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "get-me"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current user returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Current user matches authenticated identity', function () {",
                  "  pm.expect(json.data.user).to.have.property('email');",
                  "  pm.expect(json.data.user.id || json.data.user._id).to.eql(pm.environment.get('user_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Requests another verification email for qa_email. Useful after Register QA User.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{qa_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/resend-verification",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "resend-verification"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend verification is accepted', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Starts the password reset flow. The endpoint intentionally returns success whether or not the account exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{verified_user_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Forgot password is accepted', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Password - Token Placeholder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Completes password reset when reset_token is available from the password reset email. This is included as the canonical request template for the reset endpoint.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"newPassword\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "reset-password"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset password validates token', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "description": "Logs out the current token. Run this at the end of a suite if Redis token blocklisting is enabled.",
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Creates a project and stores project_id for generation, history, export, update, and cleanup requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{project_name}}\",\n  \"currentCode\": \"<main><section data-section-id=\\\"hero-section\\\" class=\\\"min-h-screen flex items-center justify-center\\\"><h1>Zorviq Starter Page</h1></section></main>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Project payload contains an id', function () {",
                  "  pm.expect(json.data._id || json.data.id).to.be.a('string');",
                  "  pm.expect(json.data.name).to.eql(pm.environment.get('project_name'));",
                  "});",
                  "pm.environment.set('project_id', json.data._id || json.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Projects",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Lists projects for the authenticated user only.",
            "url": {
              "raw": "{{base_url}}/api/projects",
              "host": ["{{base_url}}"],
              "path": ["api", "projects"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Projects list returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Projects data is an array', function () {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Project by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Fetches the active project by project_id.",
            "url": {
              "raw": "{{base_url}}/api/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{project_id}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project detail returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Project id matches environment', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data._id || data.id).to.eql(pm.environment.get('project_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Project Code",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Updates project name/currentCode before generation tests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{project_name}} - Updated\",\n  \"currentCode\": \"<main><section data-section-id=\\\"hero-section\\\" class=\\\"px-8 py-16\\\"><h1>Existing Zorviq hero</h1><p>Replace this with generated marketing copy.</p></section></main>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", "{{project_id}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project update returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Updated project keeps currentCode', function () {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.currentCode).to.include('hero-section');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - AI Code Generation",
      "item": [
        {
          "name": "Enqueue Full Page Code Generation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Primary code-generation request. Accepts a natural-language prompt and returns a queued generation job, or generated code immediately when served from cache.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"prompt\": \"Generate a responsive SaaS landing page for an AI website builder. Include hero, feature grid, pricing preview, testimonials, and a clear call to action. Use clean semantic HTML and Tailwind utility classes.\",\n  \"isSectionEdit\": false,\n  \"sectionId\": null,\n  \"sectionHtml\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "generate"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Generation enqueue returns accepted or cached result', function () {",
                  "  pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Generation job metadata is returned', function () {",
                  "  pm.expect(json.data.jobId).to.be.a('string');",
                  "  pm.expect(json.data.status).to.be.oneOf(['queued', 'done']);",
                  "  pm.expect(json.data.cached).to.be.a('boolean');",
                  "});",
                  "pm.environment.set('job_id', json.data.jobId);",
                  "if (json.data.code) pm.environment.set('generated_code', json.data.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Generation Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Polling fallback for code-generation jobs. Returns queued, streaming, done, or failed plus output when available.",
            "url": {
              "raw": "{{base_url}}/api/generate/status/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "generate", "status", "{{job_id}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status endpoint returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Status is a known generation state', function () {",
                  "  pm.expect(json.data.status).to.be.oneOf(['queued', 'streaming', 'done', 'failed']);",
                  "});",
                  "if (json.data.output) pm.environment.set('generated_code', json.data.output);"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream Generation Tokens - SSE",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "description": "Server-Sent Events endpoint for live generation tokens. In Postman, use Send and observe the response stream until a done or error event arrives.",
            "url": {
              "raw": "{{base_url}}/api/generate/stream/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "generate", "stream", "{{job_id}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('SSE stream opens successfully', function () {",
                  "  pm.expect([200]).to.include(pm.response.code);",
                  "});",
                  "pm.test('SSE content type is returned', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Enqueue Section Edit Generation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "description": "Section-level AI code edit. Requires isSectionEdit true and a lowercase alphanumeric/hyphen sectionId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"prompt\": \"Rewrite this hero section for a polished AI website builder. Add a concise headline, short supporting copy, and two accessible CTA buttons.\",\n  \"isSectionEdit\": true,\n  \"sectionId\": \"{{section_id}}\",\n  \"sectionHtml\": \"<section data-section-id=\\\"hero-section\\\" class=\\\"px-8 py-16\\\"><h1>Existing Zorviq hero</h1><p>Replace this with generated marketing copy.</p></section>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "generate"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Section edit enqueue returns accepted or cached result', function () {",
                  "  pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.environment.set('section_edit_job_id', json.data.jobId);",
                  "pm.test('Section edit job id is returned', function () {",
                  "  pm.expect(json.data.jobId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Generation History",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{auth_token}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "description": "Lists recent generation records for the active project. limit is clamped by the API between 1 and 20.",
            "url": {
              "raw": "{{base_url}}/api/generate/history/{{project_id}}?limit={{history_limit}}",
              "host": ["{{base_url}}"],
              "path": ["api", "generate", "history", "{{project_id}}"],
              "query": [
                { "key": "limit", "value": "{{history_limit}}" }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('History endpoint returns 200', function () {",
                  "  pm.response.to.have.status(200);",
